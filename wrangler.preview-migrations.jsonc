/**
 * Used only to apply D1 migrations to the Preview database, which Wrangler
 * cannot reach through wrangler.jsonc (it resolves migration targets from the
 * top-level d1_databases). The database_id must match previews.d1_databases
 * in wrangler.jsonc. See docs/devops.md, "D1 migrations".
 *
 *   npx wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"d1_databases": [
		{
			"binding": "PREVIEW_DB",
			"database_id": "9fdd4990-ea5a-4ec1-b67b-cfa5a14f619d",
			"migrations_dir": "migrations"
		}
	]
}
