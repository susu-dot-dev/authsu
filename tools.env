# Pinned tool versions: the single source of truth, read by the Makefile
# (`make check-tools`) and by CI. Bump a tool by editing this file only.
# Plain KEY=value lines (no quotes, no spaces) so both make and POSIX sh can
# include it.
TINYGO_VERSION=0.43.0
# From the official release asset digest (GitHub API) for
# tinygo0.43.0.linux-amd64.tar.gz; verified by downloading and hashing it.
TINYGO_LINUX_AMD64_SHA256=ca9fc6d055e3889462dea4450a2e42a92242d88b5c362a7ec39bdb563413d78a
GOLANGCI_LINT_VERSION=2.15.0
