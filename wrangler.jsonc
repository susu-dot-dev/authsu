/**
 * Wrangler configuration: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * The Worker is built by `build.command` below. See docs/CONTRIBUTING.md.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "authsu",
	"main": "./build/worker.mjs",
	"compatibility_date": "2026-10-18",
	"build": {
		"command": "npm run build"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * The two origins everything is derived from (docs/runbook.md, "Secrets and
	 * variables"). API_ORIGIN is the API's own origin, where this Worker is
	 * served. UI_ORIGIN is where the UI is served: passkey
	 * ceremonies run on its pages, its host is the relying party ID, and it is
	 * the one origin CORS allows. The relying party ID is permanent: a passkey is bound
	 * to it, so changing UI_ORIGIN's host invalidates every registered passkey.
	 * Set them to your deployment's real domains before the first registration
	 * (make config-set-vars). `make dev` and the e2e tests override them with
	 * localhost values, so the values here never apply to local runs.
	 * AUTH_HMAC_SECRET is a Worker secret (npx wrangler secret put), never a var.
	 */
	"vars": {
		"API_ORIGIN": "https://auth.susu.dev",
		"UI_ORIGIN": "https://susu.dev"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "6ae7ad67-1698-45d5-8fc7-df6cff311140",
			"migrations_dir": "migrations"
		}
	]
}
